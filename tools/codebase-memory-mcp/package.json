{
  "name": "@3475/codebase-memory-mcp",
  "version": "1.2.0",
  "private": true,
  "description": "Read-only local MCP server for navigating the State 3475 codebase",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "index": "node scripts/build-memory-index.mjs",
    "check:index": "node scripts/check-memory-index.mjs",
    "ast": "node scripts/build-ast-graph.mjs",
    "review": "node scripts/review-changes.mjs",
    "contracts": "node scripts/check-project-contracts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.1",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
